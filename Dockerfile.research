FROM ghcr.io/brrradley/litelabs-research-worker:9c1fe8e08be1a44273a48c019a0b3e61ebf49565

ENV PYTHONUNBUFFERED=1 \
    LITELABS_RESEARCH_BUILD=mss-candidate-lab-3.2-routed-extraction

# Incremental research build: inherit the verified image carrying DrumSep,
# Mega53, Essentia, MSS dependencies and the existing research modes.
COPY wind_brass_decomposition_v2.py /app/wind_brass_decomposition_v2.py
COPY litelabs_wind_brass_decomposition_v2_patch.py /app/litelabs_wind_brass_decomposition_v2_patch.py
COPY routed_extraction_v1.py /app/routed_extraction_v1.py
COPY litelabs_routed_extraction_patch.py /app/litelabs_routed_extraction_patch.py

# Bake the current verified BS-RoFormer-SW files so routed jobs do not spend
# ~60s downloading the baseline checkpoint at runtime.
RUN mkdir -p /models/bs_roformer_sw \
    && python - <<'PY'
from pathlib import Path
import hashlib
import requests

files = [
    (
        'https://huggingface.co/ChanTrail/BS-RoFormer/resolve/main/BS-Rofo-SW-Fixed.yaml?download=true',
        Path('/models/bs_roformer_sw/BS-Rofo-SW-Fixed.yaml'),
        None,
    ),
    (
        'https://huggingface.co/ChanTrail/BS-RoFormer/resolve/main/BS-Rofo-SW-Fixed.ckpt?download=true',
        Path('/models/bs_roformer_sw/BS-Rofo-SW-Fixed.ckpt'),
        '24e7d35ee9c64415673d3fd33e06a67cac2c103c5df6267ba1576459c775916e',
    ),
]
for url, path, expected in files:
    if not path.exists():
        with requests.get(url, stream=True, timeout=(30, 1800)) as r:
            r.raise_for_status()
            with path.open('wb') as f:
                for chunk in r.iter_content(4 * 1024 * 1024):
                    if chunk:
                        f.write(chunk)
    if expected:
        h = hashlib.sha256()
        with path.open('rb') as f:
            for chunk in iter(lambda: f.read(4 * 1024 * 1024), b''):
                h.update(chunk)
        actual = h.hexdigest()
        if actual != expected:
            raise RuntimeError(f'BS-RoFormer-SW hash mismatch: {actual}')
print('BS-RoFormer-SW baked and verified')
PY

RUN python /app/litelabs_wind_brass_decomposition_v2_patch.py \
    && python /app/litelabs_routed_extraction_patch.py \
    && python -m py_compile /app/handler.py /app/wind_brass_decomposition_v2.py /app/routed_extraction_v1.py \
    && python - <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, '/app')
import routed_extraction_v1
import wind_brass_decomposition_v2
assert hasattr(routed_extraction_v1, 'build_routed_extraction_v1')
assert routed_extraction_v1.DRUM_CHILDREN == ('kick', 'snare', 'toms', 'hh', 'ride', 'crash')
assert routed_extraction_v1.WIND_CHILDREN == ('saxophone', 'trumpet')
source = Path('/app/handler.py').read_text(encoding='utf-8')
assert 'routed_extraction_v1' in source
assert Path('/models/bs_roformer_sw/BS-Rofo-SW-Fixed.yaml').is_file()
assert Path('/models/bs_roformer_sw/BS-Rofo-SW-Fixed.ckpt').is_file()
assert Path('/models/drumsep_mdx23c/aufr33-jarredou_DrumSep_model_mdx23c_ep_141_sdr_10.8059.ckpt').is_file()
assert Path('/models/mss_training/mvsep-mega53/model.ckpt').is_file()
print('accelerated routed extraction self-tests passed')
PY

CMD ["python", "-u", "/app/research_bootstrap.py"]
