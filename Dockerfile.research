FROM ghcr.io/brrradley/litelabs-research-worker:9c1fe8e08be1a44273a48c019a0b3e61ebf49565

ENV PYTHONUNBUFFERED=1 \
    LITELABS_RESEARCH_BUILD=mss-candidate-lab-3.1-wind-brass-v2

# Incremental research build: inherit the last verified v1 image so we do not
# re-download Essentia, DrumSep, Mega53, Python dependencies or MSS assets.
COPY wind_brass_decomposition_v2.py /app/wind_brass_decomposition_v2.py
COPY litelabs_wind_brass_decomposition_v2_patch.py /app/litelabs_wind_brass_decomposition_v2_patch.py

RUN python /app/litelabs_wind_brass_decomposition_v2_patch.py \
    && python -m py_compile /app/handler.py /app/wind_brass_decomposition_v2.py \
    && python - <<'PY'
import inspect
import sys
from pathlib import Path
sys.path.insert(0, '/app')
import handler
import wind_brass_decomposition_v2
assert hasattr(wind_brass_decomposition_v2, 'build_wind_brass_decomposition_v2')
assert wind_brass_decomposition_v2.TARGETS == ('saxophone', 'trumpet')
source = Path('/app/handler.py').read_text(encoding='utf-8')
assert 'wind_brass_decomposition_v2' in source
assert Path('/models/mss_training/mvsep-mega53/config.yaml').is_file()
assert Path('/models/mss_training/mvsep-mega53/model.ckpt').is_file()
assert Path('/models/instrument_wireframe/discogs-effnet-bs64-1.pb').is_file()
print('incremental wind/brass v2 self-tests passed')
PY

CMD ["python", "-u", "/app/research_bootstrap.py"]
