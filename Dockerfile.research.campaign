FROM ghcr.io/brrradley/litelabs-research-worker:7cedb8c2bca7a330ffe7d7aa53692b96942a7ee6

ENV PYTHONUNBUFFERED=1 \
    LITELABS_RESEARCH_BUILD=experimental-vocal-cross-song-validation-v7

# Reuse the fully verified v6 image so we do not rebuild/download the large vocal
# model stack. Add only the final cross-song validation script and the cheap
# hh+cymbals -> hats output merge for the experimental drum child path.
COPY experimental_vocal_cross_song_validation.py /app/experimental_vocal_cross_song_validation.py
COPY experimental_children_v1.py /app/experimental_children_v1.py
COPY litelabs_drum_hats_merge_patch.py /app/litelabs_drum_hats_merge_patch.py

RUN python /app/litelabs_drum_hats_merge_patch.py \
    && python -m py_compile \
        /app/experimental_vocal_cross_song_validation.py \
        /app/experimental_children_v1.py \
    && python - <<'PY'
from pathlib import Path
import importlib.util

vocal = Path('/app/experimental_vocal_cross_song_validation.py').read_text(encoding='utf-8')
children = Path('/app/experimental_children_v1.py').read_text(encoding='utf-8')

assert 'experimental_vocal_cross_song_validation_v7' in vocal
assert 'tears-for-fears-shout.zip' in vocal
assert 'quality_sw25_mel75_to_becruily_residual_pair' in vocal
assert 'fast_sw_to_becruily_residual_pair' in vocal
assert 'current_set_residual_orientation' in vocal
assert 'No further blend sweep is run' in vocal

assert 'in_memory_hh_plus_cymbals_before_final_encode' in children
assert '"hats": refined["hh"] + refined["cymbals"]' in children
assert 'for name, audio in final_children.items()' in children
assert 'for name in DRUM5:' not in children[children.find('final_children = {'):children.find('# Candidate B:')]

spec = importlib.util.spec_from_file_location('vocal_v7', '/app/experimental_vocal_cross_song_validation.py')
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
assert hasattr(module, 'run')
print('focused cross-song vocal validation v7 + in-memory hats merge verified')
PY

CMD ["python", "-u", "/app/research_bootstrap.py"]
