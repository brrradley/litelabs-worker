FROM ghcr.io/brrradley/litelabs-research-worker:b3848dea832b9b4bba956ba48668262c6d4018c4

ENV PYTHONUNBUFFERED=1 \
    LITELABS_RESEARCH_BUILD=multitrack-ground-truth-campaign-hotfix

# The previous research image inherited an older /app/handler.py from its base image,
# so the new campaign mode existed in Git but was never present inside the container.
# Layer the current research handler and campaign modules onto the known-good image.
COPY handler.py /app/handler.py
COPY multitrack_ground_truth_campaign.py /app/multitrack_ground_truth_campaign.py
COPY ground_truth_benchmark.py /app/ground_truth_benchmark.py
COPY research_bootstrap.py /app/research_bootstrap.py

RUN python -m py_compile \
        /app/handler.py \
        /app/multitrack_ground_truth_campaign.py \
        /app/ground_truth_benchmark.py \
        /app/research_bootstrap.py \
    && python - <<'PY'
from pathlib import Path
import importlib.util

handler = Path('/app/handler.py').read_text(encoding='utf-8')
assert 'multitrack_ground_truth_campaign' in handler
assert 'build_multitrack_ground_truth_campaign' in handler
assert Path('/app/multitrack_ground_truth_campaign.py').is_file()

spec = importlib.util.spec_from_file_location('multitrack_ground_truth_campaign', '/app/multitrack_ground_truth_campaign.py')
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
assert hasattr(module, 'build_multitrack_ground_truth_campaign')
print('multitrack ground-truth campaign hotfix verified')
PY

CMD ["python", "-u", "/app/research_bootstrap.py"]
